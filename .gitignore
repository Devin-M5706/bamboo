node_modules/

# Your actual evidence ledger and answer bank are personal. The .example.json files
# are the templates that get committed; these are not.
data/ledger.json
data/answers.json

# Runtime state: seen-posting ids, the apply queue, mined board tokens.
data/state.json
data/queue.json
data/config.json
data/boards.json

# Application tracker. The records name real companies you applied to, and the token
# file holds a live OAuth refresh token for your mailbox -- committing it would hand
# over read access to your email.
data/applications.json
data/applications.csv
data/google-token.json

# extension/vendor/validator.js is generated by `npm run build:ext` but IS committed --
# the extension will not load without it. test/extension-sync.test.js fails if it goes stale.
.gstack/
