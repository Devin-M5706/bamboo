{
  "name": "bamboo",
  "version": "0.2.0",
  "description": "Watches job boards and fills internship applications from a verified evidence ledger. Refuses anything it cannot trace.",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "bamboo": "./src/cli.js"
  },
  "scripts": {
    "setup": "node src/cli.js setup",
    "where": "node src/cli.js where",
    "init": "node src/cli.js init",
    "mine": "node src/cli.js mine",
    "poll": "node src/cli.js poll",
    "watch": "node src/cli.js watch",
    "feed": "node src/cli.js feed",
    "ledger": "node src/cli.js ledger",
    "check": "node src/cli.js check",
    "queue": "node src/cli.js queue",
    "survey": "node src/cli.js survey",
    "banner": "node src/cli.js banner",
    "help": "node src/cli.js help",
    "connect": "node src/cli.js connect",
    "track": "node src/cli.js track",
    "applications": "node src/cli.js applications",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=test/** --test-coverage-exclude=scripts/** --test-coverage-lines=90 --test-coverage-branches=78 --test-coverage-functions=85 test/*.test.js",
    "build:ext": "node scripts/build-extension.js",
    "capture:ui": "node scripts/capture-ui.js",
    "render:ui": "node scripts/render-ui.js",
    "contacts": "node src/cli.js contacts"
  },
  "files": [
    "src/",
    "extension/",
    "data/*.example.json",
    "README.md",
    "CLAUDE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Devin-M5706/bamboo.git"
  }
}
