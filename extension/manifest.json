{
  "manifest_version": 3,
  "name": "jobapplr",
  "version": "0.1.0",
  "description": "Fills internship applications from a pre-validated evidence ledger. Refuses anything it cannot trace.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.ashbyhq.com/*",
    "https://jobs.lever.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.lever.co/*"
      ],
      "js": ["vendor/validator.js", "vendor/selects.js", "content/common.js", "content/apply.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "jobapplr"
  }
}
